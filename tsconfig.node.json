{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "outDir": "dist-electron",
    "rootDir": "electron",
    "declaration": false,
    "resolveJsonModule": true
  },
  "include": ["electron/**/*"],
  "exclude": ["electron/preload.ts"]
}
