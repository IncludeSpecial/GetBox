{
  "name": "getbox",
  "version": "1.1.0",
  "description": "GetBox — локальный магазин программ для Windows",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/render-app-icon.cjs && node scripts/fetch-icons.cjs && node -e \"const fs=require('fs');const d='data/bootstrap';fs.mkdirSync(d,{recursive:true});fs.copyFileSync('electron/bootstrap/scoop-zip-install.ps1',d+'/scoop-zip-install.ps1');fs.copyFileSync('electron/bootstrap/scoop-zip-install.ps1','dist-electron/scoop-zip-install.ps1');\" && tsc -p tsconfig.node.json && vite build",
    "electron:dev": "vite",
    "dist": "npm run build && electron-builder --win portable",
    "index": "electron . --index-rebuild",
    "prewarm": "electron . --prewarm-meta",
    "test": "node scripts/verify-catalog.cjs && node scripts/smoke.cjs",
    "verify:catalog": "node scripts/verify-catalog.cjs",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "build": {
    "appId": "com.getbox.app",
    "productName": "GetBox",
    "icon": "build/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "GetBox-${version}-portable.exe"
    }
  },
  "dependencies": {
    "electron-store": "^10.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
